{
  "expo": {
    "name": "هَدْي",
    "slug": "quran-plus",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/images/Logo.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#141515"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hassanali2.quranplus",
      "versionCode": 50,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Logo.png",
        "backgroundColor": "#141515"
      },
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
    "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/Logo.png",
          "color": "#141515"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0e38a453-e8d3-4419-af56-00a4ffcd122e"
      }
    }
  }
}
