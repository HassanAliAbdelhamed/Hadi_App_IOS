{
  "expo": {
    "name": "قران +",
    "slug": "quran-plus",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/AppIcon.png",
      "resizeMode": "contain",
      "backgroundColor": "#28292e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hassanali2.quranplus",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/AppIcon.png",
        "backgroundColor": "#28292e"
      },
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "78b0fcf0-28cb-42ed-8fed-f34d1a50c90e"
      }
    }
  }
}