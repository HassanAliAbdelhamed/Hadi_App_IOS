{
  "expo": {
    "name": "قران +",
    "slug": "quran-plus",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon.jpg",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splach.png",
      "resizeMode": "contain",
      "backgroundColor": "#28292e"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hassanali2.quranplus",
      "minSdkVersion": 21,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "adaptiveIcon": {
      "foregroundImage": "./assets/images/AppIcon.jpg",
      "backgroundColor": "#28292e"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "78b0fcf0-28cb-42ed-8fed-f34d1a50c90e"
      }
    }
  }
}
